DATABASE_URL=sqlite:///./os_tracker.db
REQUEST_TIMEOUT_SECONDS=20

# Legacy API key for server-to-server integrations/scripts.
API_KEY=

# JWT authentication used by Swagger/users.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin

# Generate the password hash/salt with:
# python -m app.create_admin
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=

DISCORD_WEBHOOK_URL=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=1701643905
TRACK_POINT_RELEASES=true

# Major-release monitoring. Minor releases are recorded but do not notify.
NOTIFY_MAJOR_RELEASES=true
