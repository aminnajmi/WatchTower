# Production Docker Compose defaults for direct HTTP access. Set ALLOWED_HOSTS
# to the exact public server IP or hostname(s), without scheme or port.
APP_ENV=production
ALLOWED_HOSTS=localhost,127.0.0.1,37.120.198.236
HOST_BIND=0.0.0.0
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1

DATABASE_URL=sqlite:////app/data/os_tracker.db
REQUEST_TIMEOUT_SECONDS=20

# Legacy API key for server-to-server integrations/scripts.
API_KEY=

# Generate a new secret with: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin

# Generate the password hash/salt using `python -m app.create_admin`.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=

DISCORD_WEBHOOK_URL=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TRACK_POINT_RELEASES=true
NOTIFY_MAJOR_RELEASES=true
